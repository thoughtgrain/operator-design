  "iterations": {
    "$comment": "Every generative design pass produces exactly perPass variants, each from its own direction. Frame variants must differ pairwise by at least minPairwiseBodyDiffPct of body pixels (same pixel step as perceptibility); subject variants must differ in at least two of pattern, drawing language and subject wording (word overlap under maxSubjectOverlap).",
    "perPass": 5,
    "passKinds": [
      "subject",
      "frames",
      "revision"
    ],
    "minPairwiseBodyDiffPct": 4.0,
    "maxSubjectOverlap": 0.6,
    "drawingLanguages": [
      "patent section",
      "hidden-line isometric",
      "star atlas",
      "engineering schematic",
      "oscilloscope trace",
      "typeset diagram",
      "orthographic elevation",
      "survey plan"
    ],
    "frameAxes": {
      "composition": [
        "centred hero",
        "low horizon",
        "column-affine (P7)",
        "off-axis diagonal",
        "full-bleed field"
      ],
      "camera": [
        "front elevation",
        "three-quarter isometric",
        "top-down plan",
        "low angle",
        "section cut"
      ],
      "emphasis": [
        "brightest element at the sound source",
        "brightest element where the note lands",
        "brightest element on the most-played control's part",
        "negative space carries the subject",
        "density gradient carries the subject"
      ]
    }
  }
