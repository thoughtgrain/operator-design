{
  "$comment": "Index the MCP server and agents read: machine categories, which patterns fit each, the library by category, and how design passes iterate. Prose lives in categories.md and patterns.md; keep the three in step.",
  "categories": {
    "engine": {
      "name": "Engine",
      "sdkKinds": [
        "synth"
      ],
      "description": "A voice that makes the sound: oscillators, filters, folders, physical models."
    },
    "drum": {
      "name": "Drum",
      "sdkKinds": [
        "synth",
        "sample"
      ],
      "description": "A percussion voice or kit; the player already knows its parts by sight. Kits get model, choices and Shift from SDK 1.8."
    },
    "sampler": {
      "name": "Sampler",
      "sdkKinds": [
        "sample"
      ],
      "description": "Plays, slices or granulates recorded audio. Own screen over the sampler page from SDK 1.8, with a sample overview; stock trims return on Shift with stockShift (SDK 1.10)."
    },
    "effect": {
      "name": "Effect",
      "sdkKinds": [
        "effect"
      ],
      "description": "Processes another track's audio: delay, reverb, distortion, filter, dynamics. Own send page from SDK 1.7 (no browser preview yet)."
    },
    "player": {
      "name": "Player",
      "sdkKinds": [
        "synth"
      ],
      "description": "Generates notes for another engine (arps, generative players). Runs as a synth with resources.trackControl on aux track 12 (SDK 1.9)."
    },
    "sequencer": {
      "name": "Sequencer",
      "sdkKinds": [
        "synth"
      ],
      "description": "Step, pattern or multi-page sequencing; the state is a sequence over time. Runs as a synth with resources.trackControl on aux track 12 (SDK 1.9)."
    },
    "function": {
      "name": "Function",
      "sdkKinds": [
        "synth"
      ],
      "description": "A track whose keys are functions acting on another track (mutes, rolls, transforms). Runs as a synth with resources.trackControl on aux track 12 (SDK 1.9)."
    }
  },
